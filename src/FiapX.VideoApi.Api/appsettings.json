{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "RabbitMq": {
    "Uri": "",
    "ClientName": "video-api",
    "Exchange": "fiapx.events",
    "DeadLetterExchange": "fiapx.dlx",
    "PrefetchCount": 16,
    "ConsumerConcurrency": 4,
    "MaxHandlerAttempts": 3,
    "HandlerRetryDelay": "00:00:00.200"
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:01",
    "BatchSize": 50,
    "MaxBackoff": "00:00:30"
  },
  "Auth": {
    "Issuer": "",
    "Audience": "fiapx-api",
    "MetadataAddress": "",
    "RequireHttpsMetadata": true
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
