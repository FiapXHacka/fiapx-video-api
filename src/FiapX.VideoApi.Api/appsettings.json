{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "RabbitMq": {
    "Uri": "",
    "Exchange": "fiapx.events",
    "DeadLetterExchange": "fiapx.dlx",
    "Source": "fiapx/video-api",
    "ClientName": "video-api",
    "PrefetchCount": 10,
    "MaxHandlerAttempts": 3,
    "HandlerRetryDelay": "00:00:01"
  },
  "Outbox": {
    "BatchSize": 50,
    "PollInterval": "00:00:01",
    "MaxBackoff": "00:00:30"
  },
  "Auth": {
    "Issuer": "http://localhost:8081",
    "Audience": "fiapx-api",
    "MetadataAddress": "http://localhost:8081/.well-known/openid-configuration",
    "RequireHttpsMetadata": true
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
