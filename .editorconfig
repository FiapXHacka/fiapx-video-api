root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx,xml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
# ASP.NET Core has no SynchronizationContext; ConfigureAwait(false) adds noise without benefit.
dotnet_diagnostic.CA2007.severity = none

[tests/**.cs]
# Test method names use underscores (Method_Scenario_Result) and test types must be public for xUnit.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none

[src/**/Migrations/*.cs]
# EF Core migrations are generated code: analyzers and style rules do not apply.
generated_code = true
